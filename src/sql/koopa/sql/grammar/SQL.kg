grammar SQL extends SQLBase.

# This is a grammar targeted at SQL statements which are embedded in Cobol
# code. The rules assume they are always parsing a single SQL statement,
# and will eat any remaining unidentified tokens as 'unknown'.
#
# I'm trying to set up the rules quite defensively to eat anything unknown.
# Partly because the SQL grammar in itself is quite extensive and will take
# some time to flesh out. But also because my set of samples to test against
# is quite limited.
#
# I'm mostly basing this off [SQL-2003 BNF]. 

def sqlStatement =
    ( includeStatement
    | declareSessionStatement
    | declareGlobalTempTableStatement
    | declareTableStatement
    | declareCursorStatement
    | valuesIntoStatement
    | selectStatement
    | insertStatement
    | updateStatement
    | deleteStatement
    | mergeStatement
    | fetchStatement
    | openStatement
    | closeStatement
    | commitStatement
    | rollbackStatement
    | lockTableStatement
    | setStatement
    | getDiagnosticsStatement
    | prepareStatement
    | executeImmediateStatement
    | executeStatement
    | describeStatement
    | callStatement
    | associateLocatorsStatement
    | allocateCursorStatement
    | withSelectStatement
    
    | alterStatement
    | createStatement
    | dropStatement
    | renameStatement
    )
end

def includeStatement =
    INCLUDE identifier
end

def declareSessionStatement =
    DECLARE SESSION . identifier
    TABLE
    [unknown: --> eof]
end

def declareGlobalTempTableStatement =
    DECLARE GLOBAL TEMPORARY TABLE tableName
    [ columnDefinitions ]
    [ onCommit ]
    [unknown: --> eof]

  where def onCommit =                               # [IBM DB2 SQL Statements]
      ON COMMIT ( PRESERVE | DELETE | DROP ) ( ROWS | TABLE )
  end
end

# The DECLARE TABLE statement (DCLGEN documentation) is Db2 embedded SQL.
# The table name may be schema-qualified and/or delimited
# e.g. DECLARE "SCHEMA".T_NAME TABLE.
def declareTableStatement =                          # [IBM DB2 SQL Statements]
    DECLARE (%not sessionQualifier) tableName TABLE
    [ columnDefinitions ]
    [unknown: --> eof]

  # SESSION-qualified declarations belong to declareSessionStatement.
  where private def sessionQualifier =  SESSION '.'  end
end

# The list is all or nothing, any column form not recognised leaves the whole list as water.
def columnDefinitions =
    '(' columnDefinition (',' columnDefinition)* ')'

  where def columnDefinition =
      columnName dataType
      [ FOR ( BIT | SBCS | MIXED ) DATA ]
      [ notNull: NOT NULL ]
      [ withDefault: WITH DEFAULT ]
  end

  where def columnName =  identifier  end

end

def dataType =
    typeName [ '(' numericLiteral [',' numericLiteral] ')' ]

  where def typeName =
      ( CHARACTER | CHAR | VARCHAR | GRAPHIC | VARGRAPHIC
      | SMALLINT | INTEGER | INT | BIGINT
      | DECIMAL | DEC | NUMERIC | FLOAT | REAL | DOUBLE
      | DATE | TIME | TIMESTAMP
      | CLOB | BLOB | DBCLOB | ROWID
      )
  end
end

def valuesIntoStatement =
    VALUES [unknown: --> eof]
end

def declareCursorStatement =
    DECLARE cursorName [sensitivity] [scrollability] CURSOR

    [holdability]
    [returnability]
    [positioning]                                    # [IBM DB2 SQL Statements]

    FOR queryExpression
    
    [unknown: --> eof]
    
  where def sensitivity     =  (SENSITIVE | INSENSITIVE | ASENSITIVE)     end
  where def scrollability   =  (SCROLL | NO SCROLL)                       end
  where def holdability     =  (WITH HOLD | WITHOUT HOLD)                 end
  where def returnability   =  (WITH RETURN | WITHOUT RETURN)             end
  where def positioning     =  (WITH ROWSET POSITIONING)                  end

  # A cursor is declared FOR a select-statement. selectStatement owns all of
  # its trailing clauses (ORDER BY, FETCH FIRST, FOR UPDATE / FOR READ ONLY),
  # so there is nothing to handle at the cursor level after it.
  where def queryExpression =
      ( selectStatement
      | withSelectStatement
      | unknown: --> eof
      )
  end
end

def selectStatement =
    SELECT
    [setQuantifier]
    selectList
    [into]
    from              [ unknown: --> nextBlockOrEnd ]
    [`where]          [ unknown: --> nextBlockOrEnd ]
    [groupBy]         [ unknown: --> nextBlockOrEnd ]
    [having]          [ unknown: --> nextBlockOrEnd ]
    [orderBy]         [ unknown: --> nextBlockOrEnd ]
    [fetchFirst]      [ unknown: --> nextBlockOrEnd ]
    ( ( updatability | isolation | optimizeFor | queryno )
      [ unknown: --> nextBlockOrEnd ]
    )*
    [ unknown: --> eof ]

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
  
  # The list is split on commas structurally, item by item, with no comma
  # limiter: a %upto { ',' } would make the LimitedStream treat every comma
  # as a hard boundary, including those inside a function's argument list.
  # Instead each item consumes its own brackets (a function call or a
  # parenthesised subquery), so the only commas the split sees are the ones
  # separating items. Items end at the INTO / FROM boundary.
  where def selectList =
      sublist ((',') sublist)*

    where private def sublist =
      ( aggregateFunction
      | allColumns: '*'
      | scalarFunctionCall
      | caseExpression
      | '(' caseExpression ')'
      | parenthesizedExpression
      | valueExpression
      | unknown: --> (',' | INTO | FROM | eof)
      )
      [ columnLabel ]
      # Any remaining trailing decoration, up to the next item or the
      # INTO / FROM boundary. Bracket-free, so it cannot swallow a comma
      # that belongs to the list.
      [ unknown: --> (',' | INTO | FROM | eof) ]
    end

    where def columnLabel =
        AS columnAlias

      where def columnAlias =  identifier  end
    end
  end

  where def into =
      INTO 
      (target (',' target)*) %upto { FROM }
      
    where private def target =
      ( hostParameterSpecification
      | unknown: _+
      ) %upto { ',' }
    end
  end

  where def from =  FROM  tableReferenceList  [unknown: --> nextBlockOrEnd]  end

  # The boundary is balanced: a clause keyword inside parentheses - for
  # example the FROM of a subquery used as a comparison operand - must
  # not end the where clause.
  where def `where =
      WHERE
      ( %balancing
            <{ '(' } { ')' }>
            <{ '[' } { ']' }>
            <{ '{' } { '}' }>
            <{ leftBracketTrigraph } { rightBracketTrigraph }>
          ( ( searchCondition
            | unknown : _*
            ) %upto { whereBoundary } )
      )

    # The block starters can occur inside a parenthesised subquery, so
    # they only bound the clause when not nested. The trailing clauses -
    # FOR, the isolation WITH, OPTIMIZE, QUERYNO, WINDOW - cannot occur
    # inside a subquery, so they bound the clause unconditionally.
    where private def whereBoundary =
        ( %notnested ( FROM | WHERE | GROUP BY | HAVING | ORDER BY
                     | FETCH FIRST )
        | WINDOW | FOR | WITH | OPTIMIZE | QUERYNO | eof )
    end
  end

  where def groupBy =
      GROUP BY
      [ groupingColumn (',' groupingColumn)* ]
      [ unknown: --> nextBlockOrEnd ]

    where def groupingColumn =
        ( columnReference | numericLiteral )
    end
  end

  where def having =
      HAVING (unknown: --> nextBlockOrEnd)
  end

  where def orderBy =
      ORDER BY
      [ sortKey (',' sortKey)* ]
      [ unknown: --> nextBlockOrEnd ]

    # A sort key is a column or a select-list position, optionally with
    # a direction; anything fancier ends the list and stays water.
    where def sortKey =
        ( columnReference | numericLiteral )
        [ ascending: ASC | descending: DESC ]
    end
  end

  where def fetchFirst =
      FETCH FIRST [rowCount] [unknown: --> (ROW | ROWS | eof)]
      (ROW | ROWS) ONLY

    where def rowCount =  numericLiteral  end
  end

  where def updatability =
      FOR ( READ ONLY
          | FETCH ONLY                               # [IBM DB2 SQL Statements]
          | UPDATE [ OF columnReference (',' columnReference)* ]
          )
  end

  # Db2 allows these after the fetch clause in any order.
  where def isolation =                              # [IBM DB2 SQL Statements]
      WITH ( ur: UR | cs: CS | rs: RS | rr: RR )
  end

  where def optimizeFor =                            # [IBM DB2 SQL Statements]
      OPTIMIZE FOR numericLiteral ( ROW | ROWS )
  end

  where def queryno =                                # [IBM DB2 SQL Statements]
      QUERYNO numericLiteral
  end

  where private def nextBlockOrEnd =
      ( FROM | WHERE | GROUP BY | HAVING | ORDER BY | FETCH FIRST | WINDOW
      | FOR | WITH | OPTIMIZE | QUERYNO | eof )
  end 
end

def insertStatement =
    INSERT INTO tableName
    [ insertColumns ]
    [ insertSource ]
    [ insertRows ]
    [unknown: --> eof]

  # Both lists are all-or-nothing: they only match when every element is
  # recognised through the closing parenthesis, so a partial match can
  # never strand the statement - anything else stays trailing water.
  where def insertColumns =
      '(' columnReference (',' columnReference)* ')'
  end

  where def insertSource =
      ( insertValues
      | selectStatement
      )
  end

  # Db2 multi-row insert: ... FOR :n ROWS [NOT] ATOMIC.
  where def insertRows =                             # [IBM DB2 SQL Statements]
      FOR ( hostParameterSpecification | numericLiteral ) ROWS
      [ [NOT] ATOMIC ]
  end

  where def insertValues =
      VALUES '(' valueItem (',' valueItem)* ')'

    # Old Db2 COBOL also permits host variables without the
    # colon, whose COBOL style hyphen names need the COBOL word glue.
    where hiding def valueItem =
        ( valueExpression
        | NULL | DEFAULT
        | identifier: ( regularIdentifier: cobolWord )
        )
    end
  end
end

def updateStatement =
    UPDATE targetTable
    set
    [`where]
    [unknown: --> eof]

  where def set =
      SET
      [ assignment (',' assignment)* ]
      [ unknown: --> (WHERE | eof) ]

    # column = value expression; a complex right-hand side keeps its
    # recognised prefix and falls back to water, and an unrecognised
    # assignment ends the list with the remainder as water. The
    # boundary is balanced so a comma or WHERE inside a subquery or
    # function call does not end the assignment.
    where def assignment =
        ( %balancing
              <{ '(' } { ')' }>
              <{ '[' } { ']' }>
              <{ '{' } { '}' }>
              <{ leftBracketTrigraph } { rightBracketTrigraph }>
            ( ( columnReference '='
                ( valueExpression [unknown: _+]
                | unknown: _+
                )
              ) %upto { %notnested (',' | WHERE) } )
        )
    end
  end

  where def `where =
     WHERE
     ( CURRENT OF cursorName
     | ( searchCondition
       | unknown : _*
       ) %upto { eof }
     )
  end
end

def deleteStatement = 
    DELETE FROM targetTable
    [--> eof]
end

def mergeStatement =
    MERGE INTO tableName
    [unknown: --> eof]
end

def openStatement =
    OPEN cursorName [inputUsing]
    
  where def inputUsing =  [USING (unknown: --> eof)]  end
end

def closeStatement =
    CLOSE cursorName
end

def rollbackStatement =
    ROLLBACK
end

def lockTableStatement =
    LOCK TABLE tableName

    [unknown: --> eof]
end


## ############################################################################
## Additional DML / Transaction Control / Dynamic SQL Statements
## ----------------------------------------------------------------------------

def fetchStatement =
    FETCH [fetchOrientation] [rowsetClause] [FROM] cursorName
    [fetchFor]
    [fetchInto]
    [fetchUsingDescriptor]
    [unknown: --> eof]

  where def fetchOrientation =
      ( NEXT | PRIOR | FIRST | LAST
      | BEFORE | AFTER
      | CURRENT
      | absolute: ABSOLUTE ( hostParameterSpecification | numericLiteral )
      | relative: RELATIVE ( hostParameterSpecification | numericLiteral )
      )
  end

  # Db2 rowset-positioned fetch: FETCH NEXT ROWSET FROM c FOR :n ROWS.
  where def rowsetClause =                           # [IBM DB2 SQL Statements]
      ROWSET [ STARTING AT ( ABSOLUTE | RELATIVE )
               ( hostParameterSpecification | numericLiteral ) ]
  end

  where def fetchFor =                               # [IBM DB2 SQL Statements]
      FOR ( hostParameterSpecification | numericLiteral ) ( ROW | ROWS )
  end

  where def fetchInto =
      INTO (target (',' target)*)

    where private def target =
      ( hostParameterSpecification
      | unknown: _+
      ) %upto { ',' }
    end
  end

  where def fetchUsingDescriptor =
      USING DESCRIPTOR (unknown: --> eof)
  end
end

def commitStatement =
    COMMIT [WORK]
end

def setStatement =
    SET
    [ hostAssignment (',' hostAssignment)* ]
    [unknown: --> eof]

  where def hostAssignment =
      hostParameterSpecification '='
      ( valueExpression [unknown: --> (',' | eof)]
      | unknown: --> (',' | eof)
      )
  end
end

def getDiagnosticsStatement =
    GET DIAGNOSTICS [unknown: --> eof]
end

def prepareStatement =
    PREPARE identifier
    [prepareInto]
    FROM (unknown: --> eof)
    [unknown: --> eof]

  where def prepareInto =
      INTO (unknown: --> FROM)
  end
end

def executeImmediateStatement =
    EXECUTE IMMEDIATE (unknown: --> eof)
end

def executeStatement =
    EXECUTE identifier
    [executeUsing]
    [unknown: --> eof]

  where def executeUsing =
      USING (unknown: --> eof)
  end
end

# Stored procedure call: May be named directly or through a host variable.
def callStatement =                                  # [IBM DB2 SQL Statements]
    CALL ( hostParameterSpecification | procedureName )
    [ '(' [ functionArgument (',' functionArgument)* ] ')' ]
    [unknown: --> eof]

  where def procedureName =  tableName  end
end

# Db2 result-set processing Asscociate:
# e.g. ASSOCIATE [RESULT SET] LOCATOR(S) (...) WITH PROCEDURE ...
def associateLocatorsStatement =                     # [IBM DB2 SQL Statements]
    ASSOCIATE [RESULT SET] (LOCATOR | LOCATORS)
    [ '(' hostParameterSpecification (',' hostParameterSpecification)* ')' ]
    [ WITH PROCEDURE procedureName ]
    [unknown: --> eof]

  where def procedureName =
      ( hostParameterSpecification | tableName )
  end
end

# Db2 result-set processing Allocate:
# eg ALLOCATE c CURSOR FOR RESULT SET :rs
def allocateCursorStatement =                        # [IBM DB2 SQL Statements]
    ALLOCATE cursorName CURSOR
    [ FOR RESULT SET hostParameterSpecification ]
    [unknown: --> eof]
end

# A fullselect introduced by common table expressions. Each CTE is a
# name, an optional column list, and AS over a bounded subquery.
# Followed finally by a select.
def withSelectStatement =
    WITH
    ( commonTableExpression (',' commonTableExpression)*
      ( selectStatement
      | unknown: --> eof
      )
    | unknown: --> eof
    )

  where def commonTableExpression =
      cteName
      [ '(' columnReference (',' columnReference)* ')' ]
      AS subquery

    where def cteName =  identifier  end
  end
end

def describeStatement =
    DESCRIBE identifier
    [describeInto]
    [unknown: --> eof]

  where def describeInto =
      INTO (unknown: --> eof)
  end
end


## ############################################################################
## Data Definition Language Statements
## ----------------------------------------------------------------------------

def alterStatement =
    ALTER
    [ subject :
      ( DATABASE                                     # [IBM DB2 SQL Statements]
      | DOMAIN
      | INDEX                                        # [IBM DB2 SQL Statements]
      | [SPECIFIC] FUNCTION                          # [IBM DB2 SQL Statements]
      | MASK                                         # [IBM DB2 SQL Statements]
      | PERMISSION                                   # [IBM DB2 SQL Statements]
      | PROCEDURE                                    # [IBM DB2 SQL Statements]
      | SEQUENCE
      | STOGROUP                                     # [IBM DB2 SQL Statements]
      | TABLE
      | TABLESPACE                                   # [IBM DB2 SQL Statements]
      | (TRANSFORM | TRANSFORMS)
      | TRIGGER                                      # [IBM DB2 SQL Statements]
      | TRUSTED CONTEXT                              # [IBM DB2 SQL Statements]
      | VIEW                                         # [IBM DB2 SQL Statements]
      | SESSION                                      # IBM, Oracle
      )
    ]

    [unknown: --> eof]
end


def createStatement =
    CREATE
    [ subject :
      ( [PUBLIC] ALIAS                                # [IBM DB2 SQL Statements]
      | ASSERTION
      | CAST
      | CHARACTER SET
      | COLLATION
      | DATABASE                                      # [IBM DB2 SQL Statements]
      | DOMAIN
      | FUNCTION
      | [UNIQUE [WHERE NOT NULL]]
         INDEX                                        # [IBM DB2 SQL Statements]
      | MASK                                          # [IBM DB2 SQL Statements]
      | [ INSTANCE
        | STATIC
        | CONSTRUCTOR
        ]
        METHOD
      | ORDERING
      | PERMISSION                                    # [IBM DB2 SQL Statements]
      | PROCEDURE
      | ROLE
      | SCHEMA
      | SEQUENCE
      | SPECIFIC METHOD
      | STOGROUP                                      # [IBM DB2 SQL Statements]
      | SYNONYM                                       # [IBM DB2 SQL Statements]
      | [ (GLOBAL | LOCAL) TEMPORARY
        | AUXILIARY                                   # [IBM DB2 SQL Statements]
        | AUX                                         # [IBM DB2 SQL Statements]
        ] 
        TABLE
      | [LOB]
        TABLESPACE                                    # [IBM DB2 SQL Statements]
      | (TRANSFORM | TRANSFORMS)
      | TRANSLATION
      | TRIGGER
      | TRUSTED CONTEXT                               # [IBM DB2 SQL Statements]
      | TYPE
      | VARIABLE                                      # [IBM DB2 SQL Statements]
      | [RECURSIVE] VIEW
      )
    ]

    [unknown: --> eof]
end


def dropStatement =
    DROP
    [ subject :
      ( [PUBLIC] ALIAS                               # [IBM DB2 SQL Statements]
      | CONSTRAINT
      | DATABASE                                     # [IBM DB2 SQL Statements]
      | [SPECIFIC] FUNCTION                          # [IBM DB2 SQL Statements]
      | INDEX                                        # [IBM DB2 SQL Statements]
      | MASK                                         # [IBM DB2 SQL Statements]
      | PACKAGE                                      # [IBM DB2 SQL Statements]
      | PERMISSION                                   # [IBM DB2 SQL Statements]
      | PROCEDURE                                    # [IBM DB2 SQL Statements]
      | ROLE                                         # [IBM DB2 SQL Statements]
      | SCHEMA
      | SEQUENCE                                     # [IBM DB2 SQL Statements]
      | STOGROUP                                     # [IBM DB2 SQL Statements]
      | SYNONYM                                      # [IBM DB2 SQL Statements]
      | TABLE
      | TABLESPACE                                   # [IBM DB2 SQL Statements]
      | TRIGGER                                      # [IBM DB2 SQL Statements]
      | TRUSTED CONTEXT                              # [IBM DB2 SQL Statements]
      | TYPE                                         # [IBM DB2 SQL Statements]
      | VARIABLE                                     # [IBM DB2 SQL Statements]
      | VIEW
      )
    ]

    [ tableName ]
    [unknown: --> eof]
end

def renameStatement =
    RENAME [TABLE | INDEX]

    [unknown: --> eof]
end

## ############################################################################
## Search conditions (top-down)
## ----------------------------------------------------------------------------

# This will split the input according to the logical combinators AND, OR and
# NOT, and grouping of these by means of parentheses.

def searchCondition =
    %balancing 
        <{ '(' } { ')' }>
        <{ '[' } { ']' }>
        <{ '{' } { '}' }>
        <{ leftBracketTrigraph } { rightBracketTrigraph }>
      disjunction
end

private def leftBracketTrigraph  =  '?' ++ ('?' '(')  end
private def rightBracketTrigraph =  '?' ++ ('?' ')')  end

hiding def disjunction =
    conjunction %upto { (or | eof) }
    (or
      conjunction %upto { (or | eof) }
    )*
    
  where private def or =  %notnested OR  end
end

hiding def conjunction =
    conjunct
    (and conjunct)*

  where private def and =  %notnested AND  end

  # A BETWEEN owns the AND between its bounds, which the conjunct limit would otherwise
  # treat as a conjunction split.
  where hiding def conjunct =
      ( betweenPredicate [ (unknown: _*) %upto { (and | eof) } ]
      | negation %upto { (and | eof) }
      )
  end
end

hiding def negation =
    [NOT] term
end

hiding def term =
    ( '(' 
      ( 
        %balancing 
            <{ '(' } { ')' }>
            <{ '[' } { ']' }>
            <{ '{' } { '}' }>
            <{ leftBracketTrigraph } { rightBracketTrigraph }>
          ( searchCondition %upto { %notnested ')' } )
      ) 
      ')'

    | existsPredicate
    | inPredicate
    | nullPredicate
    | likePredicate
    | comparison
    | unknown: _*
    )
end

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# LIKE predicate (top down)
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

def likePredicate =
    rowValuePredicand
    [NOT] LIKE pattern
    [escape]
    
  where def rowValuePredicand =
      ( comparand [unknown: _*]
      | unknown: _*
      ) %upto { [NOT] LIKE }
  end

  where def pattern =
      ( stringLiteral
      | hostParameterSpecification
      | unknown: _*
      ) %before { (ESCAPE | eof) }
      
      [--> (ESCAPE | eof)]
  end
  
  where def escape =
      ESCAPE (unknown: _*)
  end
end


## ############################################################################
# IN / IS NULL / EXISTS predicates (top down)
#
#
# Note: for IN and EXISTS the parenthesised argument is kept as water, and
# because that water is not itself balanced, a clause following the predicate at
# the same AND / OR level is absorbed into it. The predicate keyword and (for IN)
# the left comparand are still named.
# This only sacrifices the split of a trailing clause
## ############################################################################
#
# The argument is consumed as water rather than matched as an explicit
# '(' ... ')', for the same reason comparison keeps its operands as water:
# the enclosing search condition already balances parentheses, and the
# trailing (unknown: _+) is bounded by the AND / OR split around the term.
# Explicitly matching the parentheses here, or opening a nested balancing
# region, disturbs that balancer and breaks the split that follows.
#
# The argument is a subquery, a value list, or a host variable; anything
# else (and any structural mismatch) falls back to plain water, which
# absorbs the rest of the term but never fails.
def inPredicate =
    comparand [NOT] IN
    ( subquery
    | inValueList
    | hostParameterSpecification
    | unknown: _+
    )

  where def inValueList =
      '(' comparand (',' comparand)* ')'
  end
end

def nullPredicate =
    comparand IS [NOT] NULL
end

def betweenPredicate =
    comparand [NOT] BETWEEN valueExpression AND valueExpression
end

def existsPredicate =
    # The NOT of NOT EXISTS is taken by the enclosing negation.
    EXISTS
    ( subquery
    | unknown: _+
    )
end


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Comparison (top-down)
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# This will split the input into two parts, separated by a comparison operator.

def comparison =
    ( valueExpression [unknown: --> comparisonOp]
    | unknown: --> comparisonOp
    )
    comparisonOp
    ( valueExpression [unknown: _+]
    | unknown: _+
    )
end

# A comparand, optionally continued with arithmetic whose terms are
# further comparands or Db2 durations (CURRENT DATE - 15 DAYS).
# Stops at the first thing it does not recognise, then falls to uniknown water.
hiding def valueExpression =
    comparand
    ( arithmeticOperator ( duration | comparand ) )*
end

def duration =                                       # [IBM DB2 SQL Statements]
    ( numericLiteral | hostParameterSpecification )
    ( MICROSECOND | MICROSECONDS | SECOND | SECONDS | MINUTE | MINUTES
    | HOUR | HOURS | DAY | DAYS | MONTH | MONTHS | YEAR | YEARS )
end

private def arithmeticOperator =
    ( '+' | '-' | '*' | '/' | concatOperator )
end

private def concatOperator =  '|' ++ '|'  end

hiding def comparand =
    ( specialRegister
    | hostParameterSpecification
    | hexLiteral
    | stringLiteral
    | numericLiteral
    | subquery
    | scalarFunctionCall
    | columnReference
    )
end

# Two-character operators must be tried before their one-character
# prefixes: with greaterThanOp first, X >= Y matched '>' alone and the
# '= Y' tail fell to water.
def comparisonOp =
    ( notEqualsOp
    | greaterThanOrEqualsOp
    | lessThanOrEqualsOp
    | equalsOp
    | greaterThanOp
    | lessThanOp
    )
end

def equalsOp              =  '='                                    end
def lessThanOp            =  '<'                                    end
def greaterThanOp         =  '>'                                    end
def notEqualsOp           =  ( '<' ++ '>' | '!' ++ '=' )  end
def greaterThanOrEqualsOp =  ( '>' ++ '=' | '!' ++ '<' )  end
def lessThanOrEqualsOp    =  ( '<' ++ '=' | '!' ++ '>' )  end


## ############################################################################
## Functions
## ----------------------------------------------------------------------------

def aggregateFunction =
    ( countAll
    | countColumn
    | generalAggregate
    )
end

# A generic scalar function call: a name and a bracket braced argument list.
def scalarFunctionCall =
    functionName '(' [ functionArgument (',' functionArgument)* ] ')'

  where def functionName =  identifier  end
end

# An argument of a scalar function or an aggregate.
def functionArgument =
    ( allColumns: '*'
    | caseExpression
    | parenthesizedExpression
    | valueExpression
    | unknown: --> (',' | ')' | eof)
    )
    [ AS dataType ]
    [ unknown: --> (',' | ')' | eof) ]
end

# A parenthesised value expression, as in (B.FE_PROC_DATE - :WS-IX DAY).
# NOTE: Use only outside search conditions!
#       Matching explicit parentheses inside one disturbs its balancer.
def parenthesizedExpression =
    '(' valueExpression ')'
end

# A CASE expression is delimited by its own keywords.
# Note: a nested CASE inside a result degrades to water.
def caseExpression =
    CASE [ caseOperand ] whenClause (whenClause)* [ elseClause ] END

  # Guarded so a searched CASE's first WHEN is never taken for a simple-CASE operand column.
  where def caseOperand =
      (%not WHEN)
      ( valueExpression
      | unknown: --> WHEN
      )
  end

  where def whenClause =
      WHEN
      whenCondition
      THEN
      ( valueExpression [unknown: --> (WHEN | ELSE | END)]
      | unknown: --> (WHEN | ELSE | END)
      )

    # Ends at THEN, a keyword which cannot occur inside the condition (a nested CASE degrades).
    where hiding def whenCondition =
        ( valueExpression %upto { THEN }
        | ( searchCondition
          | unknown: _*
          ) %upto { THEN }
        )
    end
  end

  where def elseClause =
      ELSE
      ( valueExpression [unknown: --> END]
      | unknown: --> END
      )
  end
end

def countAll =
    COUNT '(' '*' ')'
end

def countColumn =
    COUNT '(' [setQuantifier] [ functionArgument ] ')'

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
end

def generalAggregate =
    aggregateName '(' [setQuantifier]
    [ functionArgument (',' functionArgument)* ]
    ')'

  where def aggregateName =
      ( SUM | AVG | MIN | MAX | MEDIAN
      | STDDEV | VARIANCE | VAR
      | CORR | CORRELATION
      | COVAR | COVARIANCE
      | LISTAGG | XMLAGG
      | PERCENTILE_CONT | PERCENTILE_DISC
      | PERCENT_RANK | CUME_DIST
      | GROUPING
      )
  end

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
end


## ############################################################################
## Host parameters
## ----------------------------------------------------------------------------

def hostParameterSpecification =
    hostParameterName [ indicator ]

  # [IBM References to host variables] details the use of indicators.
  where def indicator =
      [ INDICATOR ] hostParameterName
  end
end

# Glue a full COBOL word back together!
# A host parameter name may contain hyphens and digits, which arrive as separate fragments.
# glue a full COBOL word back together. May be qualified, as in :STRUCT.FIELD.
# The colon may be separated from the name by whitespace; the Db2
# precompiler accepts it and customer sources use it.
def hostParameterName =  ':' hostIdentifier [++ (('.' ++ hostIdentifier)+)]

  where hiding def hostIdentifier =
      identifier: ( delimitedIdentifier
                  | regularIdentifier: cobolWord
                  )
  end
end

private def cobolWord =
    (@WORD _) ++ (
      ( @NUMBER _
      | @WORD _
      | '_'
      | '-'
      )*
    )
end


## ############################################################################
## Low level stuff.
## ----------------------------------------------------------------------------

def identifier          =  (delimitedIdentifier | regularIdentifier)  end

def regularIdentifier   =  word  end
def delimitedIdentifier =  str   end


def tableReferenceList =
    tableReference ( joinOperator tableReference [joinCondition] )*

  # Tables are separated either by a comma (cross join) or by an explicit
  # join operator. Either way each table surfaces as its own tableReference.
  where private def joinOperator =
      ( ','
      | [ INNER
        | ( LEFT | RIGHT | FULL ) [ OUTER ]
        | CROSS
        ] JOIN
      )
  end

  # The ON / USING predicate of a join is skipped as water, bounded before the
  # next join, the next table-list separator, or the end of the FROM clause.
  where private def joinCondition =
      ( ON ( %balancing
                 <{ '(' } { ')' }>
                 <{ '[' } { ']' }>
                 <{ '{' } { '}' }>
                 <{ leftBracketTrigraph } { rightBracketTrigraph }>
               ( ( ( searchCondition
                   | unknown: _*
                   )
                   [unknown: _*]
                 ) %upto { afterJoinCondition } )
           )
      | USING (unknown: --> afterJoinCondition)
      )
  end

  # Split like the select's whereBoundary: everything through FETCH FIRST
  # can occur inside a parenthesised subquery and is guarded.
  where private def afterJoinCondition =
      ( %notnested ( ','
                   | INNER | LEFT | RIGHT | FULL | CROSS | JOIN
                   | WHERE | GROUP BY | HAVING | ORDER BY | FETCH FIRST )
      | WINDOW | FOR | WITH | OPTIMIZE | QUERYNO | eof )
  end
end

def tableReference =
    tableName [ [AS] (%not reservedAfterTableReference) correlationName ]

  where def correlationName =  identifier  end

  # These keywords following a table reference legitimately aren't correlations;
  where private def reservedAfterTableReference =
      ( INNER | LEFT | RIGHT | FULL | CROSS | JOIN
      | ON | USING
      | WHERE | GROUP | HAVING | ORDER | FETCH | WINDOW
      | FOR | WITH
      | UNION | EXCEPT | INTERSECT
      | OPTIMIZE | QUERYNO                            # [IBM DB2 SQL Statements]
      )
  end
end


def cursorName =
   [ module . ] cursorIdentifier

  where def module =  MODULE  end

  # glue a full COBOL word back together!
  where hiding def cursorIdentifier =
      identifier: ( delimitedIdentifier
                  | regularIdentifier: cobolWord
                  )
  end
end

def tableName =
    ( catalogName . ( module | schemaName ) . identifier
    |               ( module | schemaName ) . identifier
    |                                         identifier
    )

  where def module      =  MODULE      end
  where def schemaName  =  identifier  end
  where def catalogName =  identifier  end
end

def targetTable =  ( ONLY '(' tableName ')' | tableName )   end

# A parenthesised subquery.
# - The embedded select is bounded at the closing parenthesis:
#   - constructs that parse structurally (aggregates, function calls) consume their own parentheses,
#     so for them the first free ')' is the subquery's closer.
# - A subquery whose interior falls to water holding a bare ')' ends early and
#   the enclosing alternative degrades to water.
# NOTE: Only use outside a search condition: explicitly matching parentheses
#       inside one disturbs its balancer.
def subquery =
    '(' ( %balancing
              <{ '(' } { ')' }>
              <{ '[' } { ']' }>
              <{ '{' } { '}' }>
              <{ leftBracketTrigraph } { rightBracketTrigraph }>
            ( selectStatement %upto { %notnested ')' } )
        )
    ')'
end

def columnReference =
    ( tableQualifier . identifier (%not '(')
    | identifier (%not ('.' | '('))
    )

  where def tableQualifier =  identifier  end
end

# Db2 special registers usable wherever an expression is expected.
def specialRegister =                                # [IBM DB2 SQL Statements]
    ( CURRENT ( DATE
              | TIMESTAMP [ '(' numericLiteral ')' ]
              | TIME | SERVER | SQLID | SCHEMA
              | PATH | TIMEZONE | DEGREE | MEMBER )
    | USER
    )
end


def stringLiteral =  str  end

# A hexadecimal string literal, X'00'.
# The X must be tight against the string or it is an ordinary column reference.
def hexLiteral =  X ++ str  end

def numericLiteral =
    (@NUMBER _) [++ ('.' ++ (@NUMBER _))]
end

private def str =
    (@STRING _)
    
    # Because of continuations, strings may be split across lines. So we need
    # to check if there are any more parts (STRINGs) following the initial one,
    # albeit without skipping whitespace.
    [++ ((@STRING _)+)]
end


private def word =
    (@WORD _) ++ (
      ( @NUMBER _
      | @WORD _
      | '_'
      )*
    )
end


