grammar SQL extends SQLBase.

# This is a grammar targeted at SQL statements which are embedded in Cobol
# code. The rules assume they are always parsing a single SQL statement,
# and will eat any remaining unidentified tokens as 'unknown'.
#
# I'm trying to set up the rules quite defensively to eat anything unknown.
# Partly because the SQL grammar in itself is quite extensive and will take
# some time to flesh out. But also because my set of samples to test against
# is quite limited.
#
# I'm mostly basing this off [SQL-2003 BNF]. 

def sqlStatement =
    ( includeStatement
    | declareSessionStatement
    | declareGlobalTempTableStatement
    | declareTableStatement
    | declareCursorStatement
    | valuesIntoStatement
    | selectStatement
    | insertStatement
    | updateStatement
    | deleteStatement
    | mergeStatement
    | fetchStatement
    | openStatement
    | closeStatement
    | commitStatement
    | rollbackStatement
    | lockTableStatement
    | setStatement
    | getDiagnosticsStatement
    | prepareStatement
    | executeImmediateStatement
    | executeStatement
    | describeStatement
    | callStatement
    | associateLocatorsStatement
    | allocateCursorStatement
    | withSelectStatement
    
    | alterStatement
    | createStatement
    | dropStatement
    | renameStatement
    )
end

def includeStatement =
    INCLUDE identifier
end

def declareSessionStatement =
    DECLARE SESSION . identifier
    TABLE
    [unknown: --> eof]
end

def declareGlobalTempTableStatement =
    DECLARE GLOBAL TEMPORARY TABLE identifier
    [unknown: --> eof]
end

# The DECLARE TABLE statement (DCLGEN documentation) is Db2 embedded SQL.
# The table name may be schema-qualified and/or delimited
# e.g. DECLARE "SCHEMA".T_NAME TABLE.
def declareTableStatement =                          # [IBM DB2 SQL Statements]
    DECLARE (%not sessionQualifier) tableName TABLE
    [unknown: --> eof]

  # SESSION-qualified declarations belong to declareSessionStatement.
  where private def sessionQualifier =  SESSION '.'  end
end

def valuesIntoStatement =
    VALUES [unknown: --> eof]
end

def declareCursorStatement =
    DECLARE cursorName [sensitivity] [scrollability] CURSOR

    [holdability]
    [returnability]
    [positioning]                                    # [IBM DB2 SQL Statements]

    FOR queryExpression
    
    [unknown: --> eof]
    
  where def sensitivity     =  (SENSITIVE | INSENSITIVE | ASENSITIVE)     end
  where def scrollability   =  (SCROLL | NO SCROLL)                       end
  where def holdability     =  (WITH HOLD | WITHOUT HOLD)                 end
  where def returnability   =  (WITH RETURN | WITHOUT RETURN)             end
  where def positioning     =  (WITH ROWSET POSITIONING)                  end

  # A cursor is declared FOR a select-statement. selectStatement owns all of
  # its trailing clauses (ORDER BY, FETCH FIRST, FOR UPDATE / FOR READ ONLY),
  # so there is nothing to handle at the cursor level after it.
  where def queryExpression =
      ( selectStatement
      | unknown: --> eof
      )
  end
end

def selectStatement =
    SELECT
    [setQuantifier]
    selectList
    [into]
    from              [ unknown: --> nextBlockOrEnd ]
    [`where]          [ unknown: --> nextBlockOrEnd ]
    [groupBy]         [ unknown: --> nextBlockOrEnd ]
    [having]          [ unknown: --> nextBlockOrEnd ]
    [orderBy]         [ unknown: --> nextBlockOrEnd ]
    [fetchFirst]      [ unknown: --> nextBlockOrEnd ]
    [updatability]    [ unknown: --> eof ]

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
  
  where def selectList =
      (sublist (',' sublist)*) %upto { (INTO | FROM) }
      
    where private def sublist =
      # An aggregate may carry a column alias ([AS] name) or other
      # trailing decoration; keep it as water so the list and the
      # following INTO/FROM still engage.
      ( aggregateFunction [unknown: _+]
      | unknown: _+
      ) %upto { ',' }
    end
  end

  where def into =
      INTO 
      (target (',' target)*) %upto { FROM }
      
    where private def target =
      ( hostParameterSpecification
      | unknown: _+
      ) %upto { ',' }
    end
  end

  where def from =  FROM  tableReferenceList  [unknown: --> nextBlockOrEnd]  end

  where def `where =
      WHERE
      ( searchCondition
      | unknown : _*
      ) %upto { nextBlockOrEnd }
  end

  where def groupBy =
      GROUP BY (unknown: --> nextBlockOrEnd)
  end

  where def having =
      HAVING (unknown: --> nextBlockOrEnd)
  end

  where def orderBy =
      ORDER BY (unknown: --> nextBlockOrEnd)
  end

  where def fetchFirst =
      FETCH FIRST (unknown: --> (ROW | ROWS | eof))
      (ROW | ROWS) ONLY
  end

  where def updatability =
      FOR ( READ ONLY
          | FETCH ONLY                               # [IBM DB2 SQL Statements]
          | UPDATE [ OF (unknown: --> nextBlockOrEnd) ]
          )
  end

  where private def nextBlockOrEnd =
      ( FROM | WHERE | GROUP BY | HAVING | ORDER BY | FETCH FIRST | WINDOW
      | FOR | WITH | eof )
  end 
end

def insertStatement =
    INSERT INTO tableName
    [unknown: --> eof]
end

def updateStatement =
    UPDATE targetTable
    set
    [`where]
    [unknown: --> eof]

  where def set =  SET (unknown: --> (WHERE | eof))  end

  where def `where =
     WHERE
     ( CURRENT OF cursorName
     | ( searchCondition
       | unknown : _*
       ) %upto { eof }
     )
  end
end

def deleteStatement = 
    DELETE FROM targetTable
    [--> eof]
end

def mergeStatement =
    MERGE INTO tableName
    [unknown: --> eof]
end

def openStatement =
    OPEN cursorName [inputUsing]
    
  where def inputUsing =  [USING (unknown: --> eof)]  end
end

def closeStatement =
    CLOSE cursorName
end

def rollbackStatement =
    ROLLBACK
end

def lockTableStatement =
    LOCK TABLE tableName

    [unknown: --> eof]
end


## ############################################################################
## Additional DML / Transaction Control / Dynamic SQL Statements
## ----------------------------------------------------------------------------

def fetchStatement =
    FETCH [fetchOrientation] cursorName
    [fetchInto]
    [fetchUsingDescriptor]
    [unknown: --> eof]

  where def fetchOrientation =
      ( NEXT | PRIOR | FIRST | LAST
      | BEFORE | AFTER
      | CURRENT
      )
  end

  where def fetchInto =
      INTO (target (',' target)*)

    where private def target =
      ( hostParameterSpecification
      | unknown: _+
      ) %upto { ',' }
    end
  end

  where def fetchUsingDescriptor =
      USING DESCRIPTOR (unknown: --> eof)
  end
end

def commitStatement =
    COMMIT [WORK]
end

def setStatement =
    SET [unknown: --> eof]
end

def getDiagnosticsStatement =
    GET DIAGNOSTICS [unknown: --> eof]
end

def prepareStatement =
    PREPARE identifier
    [prepareInto]
    FROM (unknown: --> eof)
    [unknown: --> eof]

  where def prepareInto =
      INTO (unknown: --> FROM)
  end
end

def executeImmediateStatement =
    EXECUTE IMMEDIATE (unknown: --> eof)
end

def executeStatement =
    EXECUTE identifier
    [executeUsing]
    [unknown: --> eof]

  where def executeUsing =
      USING (unknown: --> eof)
  end
end

# Stored procedure call: May be named directly or through a host variable.
def callStatement =                                  # [IBM DB2 SQL Statements]
    CALL ( hostParameterSpecification | procedureName )
    [unknown: --> eof]

  where def procedureName =  tableName  end
end

# Db2 result-set processing Asscociate:
# e.g. ASSOCIATE [RESULT SET] LOCATOR(S) (...) WITH PROCEDURE ...
def associateLocatorsStatement =                     # [IBM DB2 SQL Statements]
    ASSOCIATE [RESULT SET] (LOCATOR | LOCATORS)
    [unknown: --> eof]
end

# Db2 result-set processing Allocate:
# eg ALLOCATE c CURSOR FOR RESULT SET :rs
def allocateCursorStatement =                        # [IBM DB2 SQL Statements]
    ALLOCATE cursorName CURSOR
    [unknown: --> eof]
end

def withSelectStatement =
    WITH (unknown: --> eof)
end

def describeStatement =
    DESCRIBE identifier
    [describeInto]
    [unknown: --> eof]

  where def describeInto =
      INTO (unknown: --> eof)
  end
end


## ############################################################################
## Data Definition Language Statements
## ----------------------------------------------------------------------------

def alterStatement =
    ALTER
    [ subject :
      ( DATABASE                                     # [IBM DB2 SQL Statements]
      | DOMAIN
      | INDEX                                        # [IBM DB2 SQL Statements]
      | [SPECIFIC] FUNCTION                          # [IBM DB2 SQL Statements]
      | MASK                                         # [IBM DB2 SQL Statements]
      | PERMISSION                                   # [IBM DB2 SQL Statements]
      | PROCEDURE                                    # [IBM DB2 SQL Statements]
      | SEQUENCE
      | STOGROUP                                     # [IBM DB2 SQL Statements]
      | TABLE
      | TABLESPACE                                   # [IBM DB2 SQL Statements]
      | (TRANSFORM | TRANSFORMS)
      | TRIGGER                                      # [IBM DB2 SQL Statements]
      | TRUSTED CONTEXT                              # [IBM DB2 SQL Statements]
      | VIEW                                         # [IBM DB2 SQL Statements]
      | SESSION                                      # IBM, Oracle
      )
    ]

    [unknown: --> eof]
end


def createStatement =
    CREATE
    [ subject :
      ( [PUBLIC] ALIAS                                # [IBM DB2 SQL Statements]
      | ASSERTION
      | CAST
      | CHARACTER SET
      | COLLATION
      | DATABASE                                      # [IBM DB2 SQL Statements]
      | DOMAIN
      | FUNCTION
      | [UNIQUE [WHERE NOT NULL]]
         INDEX                                        # [IBM DB2 SQL Statements]
      | MASK                                          # [IBM DB2 SQL Statements]
      | [ INSTANCE
        | STATIC
        | CONSTRUCTOR
        ]
        METHOD
      | ORDERING
      | PERMISSION                                    # [IBM DB2 SQL Statements]
      | PROCEDURE
      | ROLE
      | SCHEMA
      | SEQUENCE
      | SPECIFIC METHOD
      | STOGROUP                                      # [IBM DB2 SQL Statements]
      | SYNONYM                                       # [IBM DB2 SQL Statements]
      | [ (GLOBAL | LOCAL) TEMPORARY
        | AUXILIARY                                   # [IBM DB2 SQL Statements]
        | AUX                                         # [IBM DB2 SQL Statements]
        ] 
        TABLE
      | [LOB]
        TABLESPACE                                    # [IBM DB2 SQL Statements]
      | (TRANSFORM | TRANSFORMS)
      | TRANSLATION
      | TRIGGER
      | TRUSTED CONTEXT                               # [IBM DB2 SQL Statements]
      | TYPE
      | VARIABLE                                      # [IBM DB2 SQL Statements]
      | [RECURSIVE] VIEW
      )
    ]

    [unknown: --> eof]
end


def dropStatement =
    DROP
    [ subject :
      ( [PUBLIC] ALIAS                               # [IBM DB2 SQL Statements]
      | CONSTRAINT
      | DATABASE                                     # [IBM DB2 SQL Statements]
      | [SPECIFIC] FUNCTION                          # [IBM DB2 SQL Statements]
      | INDEX                                        # [IBM DB2 SQL Statements]
      | MASK                                         # [IBM DB2 SQL Statements]
      | PACKAGE                                      # [IBM DB2 SQL Statements]
      | PERMISSION                                   # [IBM DB2 SQL Statements]
      | PROCEDURE                                    # [IBM DB2 SQL Statements]
      | ROLE                                         # [IBM DB2 SQL Statements]
      | SCHEMA
      | SEQUENCE                                     # [IBM DB2 SQL Statements]
      | STOGROUP                                     # [IBM DB2 SQL Statements]
      | SYNONYM                                      # [IBM DB2 SQL Statements]
      | TABLE
      | TABLESPACE                                   # [IBM DB2 SQL Statements]
      | TRIGGER                                      # [IBM DB2 SQL Statements]
      | TRUSTED CONTEXT                              # [IBM DB2 SQL Statements]
      | TYPE                                         # [IBM DB2 SQL Statements]
      | VARIABLE                                     # [IBM DB2 SQL Statements]
      | VIEW
      )
    ]

    [unknown: --> eof]
end

def renameStatement =
    RENAME [TABLE | INDEX]

    [unknown: --> eof]
end

## ############################################################################
## Search conditions (top-down)
## ----------------------------------------------------------------------------

# This will split the input according to the logical combinators AND, OR and
# NOT, and grouping of these by means of parentheses.

def searchCondition =
    %balancing 
        <{ '(' } { ')' }>
        <{ '[' } { ']' }>
        <{ '{' } { '}' }>
        <{ leftBracketTrigraph } { rightBracketTrigraph }>
      disjunction
end

private def leftBracketTrigraph  =  '?' ++ ('?' '(')  end
private def rightBracketTrigraph =  '?' ++ ('?' ')')  end

hiding def disjunction =
    conjunction %upto { (or | eof) }
    (or
      conjunction %upto { (or | eof) }
    )*
    
  where private def or =  %notnested OR  end
end

hiding def conjunction =
    negation %upto { (and | eof) }
    (and
     negation %upto { (and | eof) }
    )*
    
  where private def and =  %notnested AND  end
end

hiding def negation =
    [NOT] term
end

hiding def term =
    ( '(' 
      ( 
        %balancing 
            <{ '(' } { ')' }>
            <{ '[' } { ']' }>
            <{ '{' } { '}' }>
            <{ leftBracketTrigraph } { rightBracketTrigraph }>
          ( searchCondition %upto { %notnested ')' } )
      ) 
      ')'

    | likePredicate
    | comparison
    | unknown: _*
    )
end

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# LIKE predicate (top down)
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

def likePredicate =
    rowValuePredicand
    [NOT] LIKE pattern
    [escape]
    
  where def rowValuePredicand =
      (unknown: _*) %upto { [NOT] LIKE }
  end
  
  where def pattern =
      ( stringLiteral
      | unknown: _*
      ) %before { (ESCAPE | eof) }
      
      [--> (ESCAPE | eof)]
  end
  
  where def escape =
      ESCAPE (unknown: _*)
  end
end


# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Comparison (top-down)
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# This will split the input into two parts, separated by a comparison operator.

def comparison =
    (unknown: --> comparisonOp)
    comparisonOp
    (unknown: _+)
end

def comparisonOp =
    ( greaterThanOp
    | lessThanOrEqualsOp
    | greaterThanOrEqualsOp
    | equalsOp
    | notEqualsOp
    | lessThanOp
    )
end

def equalsOp              =  '='                                    end
def lessThanOp            =  '<'                                    end
def greaterThanOp         =  '>'                                    end
def notEqualsOp           =  ( '<' ++ '>' | '!' ++ '=' )  end
def greaterThanOrEqualsOp =  ( '>' ++ '=' | '!' ++ '<' )  end
def lessThanOrEqualsOp    =  ( '<' ++ '=' | '!' ++ '>' )  end


## ############################################################################
## Functions
## ----------------------------------------------------------------------------

def aggregateFunction =
    ( countAll
    | countColumn
    | generalAggregate
    )
end

def countAll =
    COUNT '(' '*' ')'
end

def countColumn =
    COUNT '(' [setQuantifier] (unknown: --> ')') ')'

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
end

def generalAggregate =
    aggregateName '(' [setQuantifier] (unknown: --> ')') ')'

  where def aggregateName =
      ( SUM | AVG | MIN | MAX | MEDIAN
      | STDDEV | VARIANCE | VAR
      | CORR | CORRELATION
      | COVAR | COVARIANCE
      | LISTAGG | XMLAGG
      | PERCENTILE_CONT | PERCENTILE_DISC
      | PERCENT_RANK | CUME_DIST
      | GROUPING
      )
  end

  where def setQuantifier =  ( distinct: DISTINCT | all: ALL )  end
end


## ############################################################################
## Host parameters
## ----------------------------------------------------------------------------

def hostParameterSpecification =
    hostParameterName [ indicator ]

  # [IBM References to host variables] details the use of indicators.
  where def indicator =
      [ INDICATOR ] hostParameterName
  end
end

# Glue a full COBOL word back together!
# A host parameter name may contain hyphens and digits, which arrive as separate fragments.
# glue a full COBOL word back together. May be qualified, as in :STRUCT.FIELD.
def hostParameterName =  ':' ++ hostIdentifier [++ (('.' ++ hostIdentifier)+)]

  where hiding def hostIdentifier =
      identifier: ( delimitedIdentifier
                  | regularIdentifier: cobolWord
                  )
  end
end

private def cobolWord =
    (@WORD _) ++ (
      ( @NUMBER _
      | @WORD _
      | '_'
      | '-'
      )*
    )
end


## ############################################################################
## Low level stuff.
## ----------------------------------------------------------------------------

def identifier          =  (delimitedIdentifier | regularIdentifier)  end

def regularIdentifier   =  word  end
def delimitedIdentifier =  str   end


def tableReferenceList =
    tableReference ( joinOperator tableReference [joinCondition] )*

  # Tables are separated either by a comma (cross join) or by an explicit
  # join operator. Either way each table surfaces as its own tableReference.
  where private def joinOperator =
      ( ','
      | [ INNER
        | ( LEFT | RIGHT | FULL ) [ OUTER ]
        | CROSS
        ] JOIN
      )
  end

  # The ON / USING predicate of a join is skipped as water, bounded before the
  # next join, the next table-list separator, or the end of the FROM clause.
  where private def joinCondition =
      ( ON    (unknown: --> afterJoinCondition)
      | USING (unknown: --> afterJoinCondition)
      )
  end

  where private def afterJoinCondition =
      ( ','
      | INNER | LEFT | RIGHT | FULL | CROSS | JOIN
      | WHERE | GROUP BY | HAVING | ORDER BY | FETCH FIRST | WINDOW
      | FOR | WITH | eof )
  end
end

def tableReference =
    tableName [ [AS] (%not reservedAfterTableReference) correlationName ]

  where def correlationName =  identifier  end

  # These keywords following a table reference legitimately aren't correlations;
  where private def reservedAfterTableReference =
      ( INNER | LEFT | RIGHT | FULL | CROSS | JOIN
      | ON | USING
      | WHERE | GROUP | HAVING | ORDER | FETCH | WINDOW
      | FOR | WITH
      | UNION | EXCEPT | INTERSECT
      | OPTIMIZE | QUERYNO                            # [IBM DB2 SQL Statements]
      )
  end
end


def cursorName =
   [ module . ] identifier

  where def module =  MODULE  end
end

def tableName =
    ( catalogName . ( module | schemaName ) . identifier
    |               ( module | schemaName ) . identifier
    |                                         identifier
    )

  where def module      =  MODULE      end
  where def schemaName  =  identifier  end
  where def catalogName =  identifier  end
end

def targetTable =  ( ONLY '(' tableName ')' | tableName )   end


def stringLiteral =  str  end

private def str =
    (@STRING _)
    
    # Because of continuations, strings may be split across lines. So we need
    # to check if there are any more parts (STRINGs) following the initial one,
    # albeit without skipping whitespace.
    [++ ((@STRING _)+)]
end


private def word =
    (@WORD _) ++ (
      ( @NUMBER _
      | @WORD _
      | '_'
      )*
    )
end


# -----------------------------------------------------------------------------
#
# References
#
# [SQL-2003 BNF]
#   http://savage.net.au/SQL/sql-2003-2.bnf
#
# [IBM DB2 SQL Statements]
#   http://www.ibm.com/support/knowledgecenter/en/SSEPEK_11.0.0/com.ibm.db2z11.doc.sqlref/src/tpc/db2z_sql_statementsintro.html
#
# [IBM References to host variables]
#   http://www.ibm.com/support/knowledgecenter/ssw_ibm_i_71/db2/rbafzch2host.htm
