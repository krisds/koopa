target callStatement;

# Procedure named through a host variable.
+[ CALL :WS-CIFSP015 ( :CIFC015-FUNCTION-TYPE, :CIFC015-RESP-TYPE ) ]

# Directly named, optionally qualified.
+[ CALL SYSPROC.DSNUTILU ( :UTILITY-ID, :RESTART, :UTSTMT, :RETCODE ) ]
+[ CALL MYPROC ]

-[ CALLX MYPROC ]


target associateLocatorsStatement;

+[ ASSOCIATE LOCATOR ( :SP015RSET ) WITH PROCEDURE :WS-CIFSP015 ]
+[ ASSOCIATE LOCATORS ( :WS-RS-LOCATOR ) WITH PROCEDURE :CONST-PGM-CIFSP011 ]
+[ ASSOCIATE RESULT SET LOCATOR ( :LOC1 ) WITH PROCEDURE P1 ]
+[ ASSOCIATE LOCATOR ( :WS-RS-LOCATOR ) WITH PROCEDURE :CONST-PGM ]


target allocateCursorStatement;

+[ ALLOCATE CTYCSR CURSOR FOR RESULT SET :SP015RSET ]
+[ ALLOCATE RS112_CSR CURSOR FOR RESULT SET :WS-RS-LOCATOR ]


target withSelectStatement;

+[ WITH RELOBJ ( REL_OBJECT, LVL ) AS
     ( SELECT REL_OBJECT, 1 FROM T310_RELATION )
   SELECT REL_OBJECT FROM RELOBJ ]
