target declareCursorStatement;

# Example by Suman Saurabh.
+[ DECLARE AB05 CURSOR WITH RETURN FOR                 
   SELECT                                                       
      PPPPPPP_CODE                                            
     ,RRRRRRR_DESC                                            
     ,IIPACT_CONDITION                                        
     ,VVVVVV_ID                                               
     ,CARR_ID                                              
   FROM SESSION.AB05 ]

# Basic cursor with WHERE — selectStatement should have where child
+[ DECLARE C1 CURSOR FOR
   SELECT CUST_NAME, CUST_SSN
   FROM CUSTOMER_MASTER
   WHERE CUST_ID = 42 ]

# Cursor WITHOUT WHERE — selectStatement should exist but lack where child
+[ DECLARE C2 CURSOR FOR
   SELECT CUST_NAME, CUST_SSN
   FROM CUSTOMER_MASTER ]

# Cursor with SELECT * without WHERE
+[ DECLARE C3 CURSOR FOR
   SELECT *
   FROM EMPLOYEE ]

# Cursor with aggregate without WHERE
+[ DECLARE C4 CURSOR FOR
   SELECT COUNT(*)
   FROM ACCOUNTS ]

# Cursor with GROUP BY, no WHERE
+[ DECLARE C5 CURSOR FOR
   SELECT CARD_NUMBER, COUNT(*)
   FROM PAYMENT_CARDS
   GROUP BY CARD_NUMBER ]

# Cursor with ORDER BY, no WHERE
+[ DECLARE C6 CURSOR FOR
   SELECT ACCT_ID, BALANCE
   FROM ACCOUNTS
   ORDER BY BALANCE ]

# Cursor with WHERE and ORDER BY
+[ DECLARE C7 CURSOR FOR
   SELECT ACCT_ID, BALANCE
   FROM ACCOUNTS
   WHERE STATUS = 'A'
   ORDER BY BALANCE ]

# Cursor WITH HOLD
+[ DECLARE C8 CURSOR WITH HOLD FOR
   SELECT COL1, COL2
   FROM TABLE1
   WHERE COL3 = 'X'
   ORDER BY COL1 ]

# Cursor WITH HOLD, no WHERE — batch full-scan pattern
+[ DECLARE C9 CURSOR WITH HOLD FOR
   SELECT OPERATOR_ID, OPERATOR_DATA
   FROM T923_PROFILE_DATA
   ORDER BY OPERATOR_ID ]

# Cursor from SESSION temp table without WHERE
+[ DECLARE C10 CURSOR FOR
   SELECT TMP_ACCT_ID, TMP_STATUS
   FROM SESSION.TEMP_RESULTS ]

# Cursor with DISTINCT
+[ DECLARE C11 CURSOR FOR
   SELECT DISTINCT STATUS
   FROM ACCOUNTS ]

# INSENSITIVE SCROLL cursor — UI pagination pattern
+[ DECLARE C12 INSENSITIVE SCROLL CURSOR FOR
   SELECT TRN_PROC_DAY, TRN_FE, TRN_TRAN_NB
   FROM SESSION.TEMP_TRNSRCH ]

# Cursor with multi-table join and WHERE
+[ DECLARE C13 CURSOR FOR
   SELECT A.CUST_NAME, B.ACCT_NUM, B.BALANCE
   FROM CUSTOMER_MASTER A, ACCOUNTS B
   WHERE A.CUST_ID = B.CUST_ID ]

# Cursor with multi-table join without WHERE — cross join leak
+[ DECLARE C14 CURSOR FOR
   SELECT A.CUST_NAME, B.ACCT_NUM
   FROM CUSTOMER_MASTER A, ACCOUNTS B ]

# Cursor with subquery in WHERE
+[ DECLARE C15 CURSOR FOR
   SELECT CUST_NAME
   FROM CUSTOMER_MASTER
   WHERE CUST_ID IN (SELECT CUST_ID FROM ACCOUNTS WHERE BALANCE > 10000) ]

# Cursor with FETCH FIRST N ROWS ONLY
+[ DECLARE C16 CURSOR FOR
   SELECT CUST_NAME, CUST_SSN
   FROM CUSTOMER_MASTER
   FETCH FIRST 100 ROWS ONLY ]

# Cursor with FOR FETCH ONLY (read-only)
+[ DECLARE C17 CURSOR FOR
   SELECT FE_ID, FE_PROC_DATE
   FROM T903_FE
   ORDER BY FE_ID
   FOR FETCH ONLY ]

# Cursor with WITH UR (uncommitted read — reporting context)
+[ DECLARE C18 CURSOR FOR
   SELECT FE_ID, FE_PROC_DATE
   FROM T903_FE
   ORDER BY FE_ID
   WITH UR ]

# A dynamic cursor over a prepared statement name.
+[ DECLARE TRNCSR CURSOR FOR TRNSEARH ]

# Parenthesised branches chained with a set operator.
+[ DECLARE C1 CURSOR FOR
   ( SELECT A FROM T1 WHERE X = :WS-X )
   UNION ALL
   ( SELECT A FROM T2 WHERE Y = :WS-Y ) ]
