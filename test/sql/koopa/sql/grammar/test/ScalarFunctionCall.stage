target scalarFunctionCall;

+[ SUBSTR(NAME, 1, 3) ]
+[ DIGITS(BALANCE) ]
+[ COALESCE(A, B, 0) ]
+[ VALUE(A, 'N') ]

# Nested calls recurse; internal commas belong to the inner list.
+[ COALESCE(SUBSTR(NAME, 1, 3), 'X') ]

# Not a call (no argument bracket).
-[ NAD_KEY_ID ]

# A subquery as a function argument.
+[ COALESCE((SELECT D FROM T3), 'X') ]


# Arithmetic inside arguments parses as a value expression.
+[ SUBSTR(NAME, POS + 1, LEN - 2) ]

# Hex literals, CAST targets and host-variable durations as arguments.
+[ REPLACE(:WS-OP-CIF-ID, X'00', ' ') ]
+[ CAST(ACCT_BAL AS DECIMAL(15, 2)) ]
+[ DATE(TS + :WS-COUNT MONTH) ]
