target setStatement;

# SET host variable to special register
+[ SET ] HostParameter:hostParameterSpecification [ = CURRENT TIMESTAMP ]

# SET host variable to CURRENT DATE
+[ SET ] HostParameter:hostParameterSpecification [ = CURRENT DATE ]

# SET CURRENT SQLID
+[ SET CURRENT SQLID = 'MYSCHEMA' ]

# SET CURRENT SCHEMA
+[ SET CURRENT SCHEMA = 'PRODUCTION' ]

# Host-variable assignments.
+[ SET :WS-DB2-TS = CURRENT TIMESTAMP ]
+[ SET :WS-TS = CURRENT TIMESTAMP - CURRENT TIMEZONE,
       :WS-TODAY = CURRENT DATE ]

# Special register with timestamp precision in the value.
+[ SET :WS-TS = CURRENT TIMESTAMP(12) - CURRENT TIMEZONE ]

# Bracketed date arithmetic and a sequence value as assignment values.
+[ SET :WS-DT = (CURRENT DATE - 30 DAYS)
      ,:WS-SEQ = NEXTVAL FOR PSN_INVOICE_SEQ ]

# Special register assignments.
+[ SET CURRENT PACKAGESET = :W-PACKAGESET ]
+[ SET CURRENT OPTIMIZATION HINT = :WS-SQLID ]

# Reading a special register into a host variable.
+[ SET :WS-CUR-PKGSET = CURRENT PACKAGESET ]
