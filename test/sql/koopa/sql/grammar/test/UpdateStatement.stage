target updateStatement;

+[ UPDATE STUDENT
     SET SCORE = 'A'
     WHERE CURRENT OF ] CursorName:cursorName

+[ UPDATE STUDENT
     SET SCORE = 'A'
     WHERE SID = 42 ]

+[ UPDATE T305_NAME_ADDRESS
     SET NAD_STATUS = :WS-STATUS,
         NAD_UPD_TS = CURRENT TIMESTAMP,
         NAD_COUNT  = 42
     WHERE NAD_KEY_ID = :WS-KEY-ID ]

# Complex right-hand sides keep parsing with the remainder as water.
+[ UPDATE T305_NAME_ADDRESS
     SET NAD_NAME = SUBSTR(:WS-NAME, 1, 30),
         NAD_FLAG = 'Y'
     WHERE NAD_KEY_ID = :WS-KEY-ID ]

# Scalar subquery as an assignment value.
+[ UPDATE T1
     SET C1 = (SELECT MAX(TS) FROM T2 WHERE T2.K = T1.K),
         C2 = :WS-A
     WHERE K = 1 ]

# Arithmetic on the right-hand side; the assignment boundary is balanced.
+[ UPDATE T1
     SET CNT = CNT + 1,
         TS  = CURRENT TIMESTAMP - 1 DAY
     WHERE K = 1 ]

# Row assignment: (cols) = (subquery).
+[ UPDATE SESSION.TEMP A
     SET (A.BR_NAME, A.BR_CD) = (SELECT FE_BR_NAME, FE_BR_CD FROM T WHERE X = 1)
     WHERE A.KEY = :WS-KEY ]

# Assignment values are full expressions: CASE and bracketed
# date arithmetic.
+[ UPDATE T200_FE SET
     T200_START_WK = CASE WHEN ATT_LINK = :WS-C-AUTO
                          THEN :WS-C-MAN
                          ELSE T200_START_WK END
    ,T200_TS = (CURRENT TIMESTAMP(9) - CURRENT TIMEZONE)
    ,T200_DT = (CURRENT DATE - 1 DAY)
   WHERE T200_ID = :WS-ID ]

# Row assignment with a value list.
+[ UPDATE T006 SET (ADD_LINE, ADD_PURGE_DT) =
          (:WS-LINE, CURRENT DATE + 30 DAYS)
   WHERE ADD_FE = :WS-FE ]
