target valuesIntoStatement;

# Basic VALUES with scalar expression
+[ VALUES ( CURRENT DATE ) INTO ] HostParameter:hostParameterSpecification

# VALUES with arithmetic
+[ VALUES ( 1 + 2 ) INTO ] HostParameter:hostParameterSpecification

# VALUES with date computation
+[ VALUES ( DAY ( CURRENT DATE + 1 DAY ) ) ]

# Should reject: SELECT is not VALUES
-[ SELECT CURRENT DATE FROM DUAL ]

# Expression rows assigned into host variables.
+[ VALUES ( CURRENT TIMESTAMP - CURRENT TIMEZONE ) INTO :WS-GMT-TS ]
+[ VALUES IDENTITY_VAL_LOCAL() INTO :WS-ORDREQ-BATCH-ID ]
+[ VALUES ( DAYOFWEEK(CURRENT DATE), DAY(CURRENT DATE) )
   INTO :WS-DOW, :WS-DAY ]
