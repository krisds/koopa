target wheneverStatement;

+[ WHENEVER SQLERROR GO TO Z999-SQL-ERROR ]
+[ WHENEVER SQLERROR GOTO 9999-CALL-ABEND-ROUTINE ]
+[ WHENEVER SQLWARNING CONTINUE ]
+[ WHENEVER NOT FOUND CONTINUE ]

-[ WHENEVER SOMETHING CONTINUE ]


target declareSectionStatement;

+[ BEGIN DECLARE SECTION ]
+[ END DECLARE SECTION ]
